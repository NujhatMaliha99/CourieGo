{
  "info": {
    "name": "CourieGo Create Parcel API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [{ "key": "baseUrl", "value": "http://localhost:5000" }],
  "item": [{
    "name": "Create Parcel",
    "request": {
      "method": "POST",
      "header": [{ "key": "Content-Type", "value": "application/json" }],
      "body": {
        "mode": "raw",
        "raw": "{\n  \"sender_id\": 1,\n  \"receiver_id\": 1,\n  \"tracking_id\": \"CG-2026-001\",\n  \"parcel_type\": \"Documents\",\n  \"weight\": 0.75,\n  \"charge\": 120,\n  \"status\": \"pending\"\n}"
      },
      "url": "{{baseUrl}}/api/parcels"
    }
  }]
}
